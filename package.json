    "plugin": {
      "description": "Recent activity app destinations and Dynamic settings; no activity content is retained.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "navigation",
          "items": [
            "presented_activities"
          ],
          "properties": {
            "hint": [
              "longText"
            ]
          },
          "suggestedRefreshIntervalSec": 30

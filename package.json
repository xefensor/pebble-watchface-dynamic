{
  "name": "dynamic-watchface",
  "author": "Xef",
  "version": "1.0.0",
  "scripts": {
    "test": "python3 scripts/verify-core.py && node --test tests/*.test.js && python3 scripts/test-native.py && npm run test:workflow && npm run check:docs && npm run test:release && npm run test:platforms && npm run test:assets && npm run test:auditor && npm run test:store",
    "test:js": "node --test tests/*.test.js",
    "test:native": "python3 scripts/test-native.py",
    "build": "python3 scripts/build.py",
    "check:config": "node scripts/generate-config.cjs --check",
    "build:release": "python3 scripts/build.py --release",
    "test:workflow": "python3 -m unittest discover -s tests -p test_development_workflow.py && python3 -m unittest discover -s tests -p test_preview_provenance.py",
    "test:source": "python3 scripts/verify-core.py && node --test tests/*.test.js && python3 scripts/test-native.py",
    "check:artifact": "python3 scripts/check-candidate.py",
    "release:source": "python3 scripts/package-source.py",
    "check:docs": "python3 scripts/check-docs.py",
    "release:prepare": "python3 scripts/github-release.py prepare",
    "release:publish": "python3 scripts/github-release.py publish",
    "test:release": "python3 -m unittest discover -s tests -p \"test_*release*.py\"",
    "check:setup": "python3 scripts/check-setup.py",
    "test:platforms": "python3 -m unittest discover -s tests -p test_platform_audit.py",
    "test:assets": "python3 -m unittest discover -s tests -p test_native_assets.py",
    "test:auditor": "python3 -m unittest discover -s tests -p test_pinned_dependencies.py",
    "store:prepare": "python3 scripts/store-kit.py",
    "store:check": "python3 scripts/store-kit.py --check",
    "test:store": "python3 -m unittest discover -s tests -p test_store_kit.py"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "pebble-app",
    "watchface",
    "pebble-time-2"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.0",
    "pebble-activities": "file:vendor/pebble-activities-0.4.5.tgz",
    "pebble-watchface-core": "file:vendor/pebble-watchface-core-0.6.1-dev.0.tgz",
    "pebble-xoce-ui": "file:vendor/pebble-xoce-ui-0.1.3.tgz"
  },
  "pebble": {
    "displayName": "Dynamic",
    "uuid": "cc1281f1-3b4d-45b5-b235-6881b1fd8fbd",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "ReadMusic",
        "reason": "To show the current track and album artwork",
        "required": false
      },
      {
        "name": "Notifications",
        "reason": "To show notification information you enable",
        "required": false
      },
      {
        "name": "Location",
        "reason": "To show weather for your selected or current location",
        "required": false
      },
      {
        "name": "ReadWatchSettings",
        "reason": "To read watch preferences used by the display",
        "required": false
      }
    ],
    "messageKeys": [
      "TEMPERATURE",
      "REQUEST_WEATHER",
      "BACKGROUND_COLOR",
      "TEXT_COLOR",
      "DEPTH_EFFECT",
      "TEXT_SHADOW",
      "LARGE_TEXT",
      "USE_12_HOUR",
      "USE_FAHRENHEIT",
      "TEMPERATURE_FAHRENHEIT",
      "WEATHER_UPDATED_AT",
      "FORECAST_DATA",
      "FOLLOW_PEBBLE_UNITS",
      "WEATHER_LOCATION",
      "WEATHER_CLEAR",
      "SHOW_DAILY_RANGE",
      "SHOW_RAIN_CHANCE",
      "WEATHER_DETAILS",
      "LAYOUT_STYLE",
      "SHOW_WEATHER_ICON",
      "WEATHER_CONDITION",
      "COMPLICATION_DATA",
      "REQUEST_COMPLICATIONS",
      "CONTEXT_DATA",
      "REQUEST_CONTEXT",
      "SHOW_MUSIC",
      "SHOW_NOTIFICATIONS",
      "NOTIFICATION_PREVIEW",
      "NOTIFICATION_APPS",
      "SHOW_STATUS",
      "PANEL_TRANSITIONS",
      "ACCENT_COLOR",
      "ANIMATIONS",
      "CLOCK_FORMAT",
      "NOTIFICATION_VIBRATION",
      "NIGHT_PALETTE",
      "NIGHT_BACKGROUND_COLOR",
      "NIGHT_TEXT_COLOR",
      "NIGHT_ACCENT_COLOR",
      "NOTIFICATION_APP_ONLY",
      "CONTEXT_STATE",
      "ACTIVITY_DATA",
      "REQUEST_ACTIVITIES",
      "SHOW_ACTIVITIES",
      "ACTIVITY_PRESENTED",
      "REQUEST_PRESENTATION",
      "TEXT_SIZE",
      "APPEARANCE_MODE",
